#!/usr/bin/env bash
# Blocks a push that would publish a secret or a private network detail.
# This repo is mirrored to a public host on every push, so this is the gate.
# Enable with `make hooks`. Bypass (after reviewing the hit) with --no-verify.
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-push: gitleaks is not installed (brew install gitleaks); refusing to push." >&2
    exit 1
fi

# Private-network details gitleaks has no rule for.
DENY='192\.168\.[0-9]+\.[0-9]+|(//|@)[a-z0-9.-]*\.home\b|/Users/[A-Za-z]|BEGIN [A-Z ]*PRIVATE KEY'
ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO" ] && continue # branch deletion
    if [ "$remote_sha" = "$ZERO" ]; then
        range=("$local_sha" --not --remotes)
    else
        range=("$remote_sha..$local_sha")
    fi

    if ! gitleaks git --no-banner --redact --log-opts="${range[*]}" .; then
        status=1
    fi

    hits=$(git log -p --no-color --format='commit %h %s' "${range[@]}" |
        grep -E "^commit |^\+" | grep -E "^commit |$DENY" |
        grep -B1 -E "^\+" | grep -v '^--$' || true)
    if [ -n "$hits" ]; then
        echo "pre-push: private detail in commits being pushed:" >&2
        echo "$hits" >&2
        status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: push blocked." >&2
fi
exit "$status"

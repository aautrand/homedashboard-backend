pipeline {
    agent any

    environment {
        NEXUS_REGISTRY = 'localhost:8082'
        IMAGE          = 'homedashboard-be'
        CONTAINER_FILE = '/home/aautrand/.config/containers/systemd/homedashboard-be.container'
    }

    stages {
        stage('Fetch Tags') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: 'nexus-credentials',
                                                      usernameVariable: 'NEXUS_USER',
                                                      passwordVariable: 'NEXUS_PASS')]) {
                        def tags = sh(
                            script: """
                                curl -s -u \$NEXUS_USER:\$NEXUS_PASS http://${NEXUS_REGISTRY}/v2/${IMAGE}/tags/list | \
                                python3 -c "import json,sys; d=json.load(sys.stdin); print('\\n'.join(sorted(d['tags'], key=lambda v: [int(x) for x in v.split('.')], reverse=True)))"
                            """,
                            returnStdout: true
                        ).trim()

                        def selected = input(
                            message: 'Select a version to deploy',
                            parameters: [
                                choice(name: 'VERSION', choices: tags, description: 'Available versions in Nexus')
                            ]
                        )
                        env.SELECTED_VERSION = selected
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(['aautrand-deploy-key']) {
                    sh """
                        ssh -o StrictHostKeyChecking=no aautrand@localhost '
                            sed -i "s|^Image=.*|Image=${NEXUS_REGISTRY}/${IMAGE}:${env.SELECTED_VERSION}|" ${CONTAINER_FILE}
                            XDG_RUNTIME_DIR=/run/user/\$(id -u) systemctl --user daemon-reload
                            XDG_RUNTIME_DIR=/run/user/\$(id -u) systemctl --user restart homedashboard-be
                        '
                    """
                }
            }
        }
    }

    post {
        success {
            echo "homedashboard-be ${env.SELECTED_VERSION} deployed successfully"
        }
        failure {
            echo "Deployment of ${env.SELECTED_VERSION} failed"
        }
    }
}
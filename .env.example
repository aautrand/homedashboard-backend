# Reference list of the environment variables the app reads. The app does not
# load a .env file. Copy this to ~/.config/homedashboard/env (chmod 600), fill
# it in, and let the launcher pass it: `make serve`, `make migrate`, the VS Code
# launch configs, docker compose and systemd EnvironmentFile= all read it.
# Quote values that contain spaces or shell characters.

# --- PostgreSQL -----------------------------------------------------------
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- RabbitMQ (print jobs) ------------------------------------------------
RABBITMQ_HOST=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# --- MinIO ----------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=printer-images
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Bearer token the MinIO bucket-notification webhook must present.
MINIO_EVENT_TOKEN=

# --- iCloud CalDAV --------------------------------------------------------
CALDAV_ICLOUD_URL=
APPLE_USER=
# App-specific password, not the Apple ID password.
APPLE_DASHBOARD_SECRET=
MAIN_CALENDAR=

# --- AI -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only for service-account keys (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-transcribe
OLLAMA_HOST=http://localhost:11434

# --- Weather --------------------------------------------------------------
OPEN_WEATHER_API_KEY=
# "lat,long"
LAT_LONG=

# --- Recipes (Tandoor) ----------------------------------------------------
TANDOOR_URL=http://localhost:8040
TANDOOR_API_TOKEN=

# --- Misc -----------------------------------------------------------------
# Host the printed QR codes point back to.
SELF_HOST=localhost
# IANA name, e.g. America/Denver. Unset falls back to server time (UTC).
TIMEZONE=
# Printer column count (48 for 80mm paper).
RECEIPT_WIDTH=48
